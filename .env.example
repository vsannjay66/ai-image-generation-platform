# Copy this file to ".env" and fill in real values. Do NOT commit the real .env.

# JWT signing
Secret_key=change-me-to-a-long-random-string
Algorithm=HS256
access_token=30

# HuggingFace Inference token (https://huggingface.co/settings/tokens)
HF_API_TOKEN=hf_your_token_here

# Database — Postgres in production, or sqlite:///./app.db for local dev
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_image
